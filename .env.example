# Not automatically loaded. Supply environment variables via the deployment service.
# Default: loopback-only preview. No account, key or commercial approval is implied.
HOST=127.0.0.1
PORT=3000
RELEASE_MODE=preview
# For a non-loopback preview host: generate a unique secret >=32 characters.
# PREVIEW_ACCESS_CODE=
# SITE_ORIGIN=https://your-approved-domain.example
# Admin authentication and private intake runtime secrets belong in Railway/secret storage only.
# NEON_AUTH_BASE_URL=
# ADMIN_PUBLIC_ORIGIN=https://your-private-preview.example
# ADMIN_CSRF_SECRET=
# INTAKE_DATABASE_URL=postgresql://least-privilege-role:password@host/database?sslmode=require
# Keep false until privacy/consent/retention review is approved.
CUSTOM_INTAKE_PRIVATE_PILOT=false
